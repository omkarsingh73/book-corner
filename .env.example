# =============================================================================
# Book Corner Platform - Docker Environment Configuration Template
# Copy to .env and adjust credentials before production deployment.
# =============================================================================

# Application Server
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=bookcorner
POSTGRES_USER=bookcorner_admin
POSTGRES_PASSWORD=BookCorner2026!Secure

# JSON Web Token (JWT) Security Secret (Must be >= 256 bits for HMAC-SHA256)
JWT_SECRET=bookcorner_jwt_super_secret_signing_key_2026_enterprise_grade_security_must_be_256_bits
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# pgAdmin Web Management (Available with --profile tools)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@bookcorner.com
PGADMIN_PASSWORD=Admin2026!Secure
